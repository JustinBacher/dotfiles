[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    dark = true
    navigate = true
    diff-so-fancy = true
    diff-highlight = true
    features = diff-so-fancy

[merge]
    conflictStyle = zdiff3

[diff]
    colorMoved = true
    algorithm = "minimal"
    wordRegex = "."

[user]
        name = JustinBacher
        email = 92jbach@gmail.com
[pull]
        rebase = true
[push]
        autoSetupRemote = true
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
