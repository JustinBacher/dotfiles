# Font
font-family = "Maple Mono"
font-family-italic = "Maple Mono"
font-feature = +zero +calt

# Mouse
mouse-hide-while-typing = true

# Theming
alpha-blending = "linear-corrected"
background-opacity = 0.999999
background-opacity-cells = true
theme = noctalia

# Cursor
cursor-style = bar
shell-integration-features = no-cursor
focus-follows-mouse = true

# Window
gtk-single-instance = true
window-padding-balance = true
# May not want to use this on non-tiling WMs
window-decoration = false

# Other
shell-integration-features = cursor,sudo,no-title,ssh-env,ssh-terminfo
shell-integration = fish
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = true
gtk-quick-terminal-layer = overlay
# command = zellij
command = tmux new-session -A -s main

# Shaders
custom-shader = shader-playground/public/shaders/cursor_frozen.glsl
custom-shader = fade_top.glsl
custom-shader-animation = true
# custom-shader = shaders-cursor/cursor_warp.glsl


