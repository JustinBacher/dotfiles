#!/bin/sh
# Blocks commits that stage secrets. Enabled per clone with:
#   git config core.hooksPath .githooks
# Bypass a false positive for one commit with `git commit --no-verify`.
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not found (sudo pacman -S gitleaks). Commit blocked." >&2
    exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
