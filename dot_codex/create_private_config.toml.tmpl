model = "gpt-6.1-sol"
model_reasoning_effort = "medium"
approval_policy = "on-request"
approvals_reviewer = "guardian_subagent"
sandbox_mode = "workspace-write"
model_verbosity = "low"

[mcp_servers.node_repl]
args = []
command = "/usr/lib/chatgpt/resources/cua_node/bin/node_repl"
startup_timeout_sec = 120

[mcp_servers.node_repl.env]
NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS = "1000"
NODE_REPL_NODE_MODULE_DIRS = "/usr/lib/chatgpt/resources/cua_node/lib/node_modules"
NODE_REPL_NODE_PATH = "/usr/lib/chatgpt/resources/cua_node/bin/node"
NODE_REPL_TRUSTED_CODE_PATHS = "{{ .chezmoi.homeDir }}/.codex:/usr/lib/chatgpt/resources/cua_node/lib/node_modules"
CODEX_HOME = "{{ .chezmoi.homeDir }}/.codex"
BROWSER_USE_AVAILABLE_BACKENDS = "chrome,iab,mcpapps"
BROWSER_USE_TINYSKY_ENABLED = "1"
NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER = ""
NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME = ""
BROWSER_USE_CODEX_APP_BUILD_FLAVOR = "prod"
BROWSER_USE_CODEX_APP_VERSION = "26.1007.21434"
NODE_REPL_TRUSTED_SERVICES = '{"browser":"{{ .chezmoi.homeDir }}/.codex/plugins/cache/openai-bundled/browser/26.1007.21434/scripts/browser-service.mjs"}'
CODEX_CLI_PATH = "/usr/lib/chatgpt/resources/codex"

[mcp_servers.manage-my-environment]
command = "{{ .chezmoi.homeDir }}/projects/manage-my-environment/target/release/mme"
args = ["serve"]

[mcp_servers.caveman]
command = "{{ .chezmoi.homeDir }}/.caveman/bin/caveman-mcp"
env_vars = ["CAVEMAN_HOME", "CAVEMAN_CCR_DB"]

[plugins."chrome@openai-bundled"]
enabled = true

[plugins."browser@openai-bundled"]
enabled = true

[plugins."unified-computer-use@openai-bundled"]
enabled = true

[plugins."visualize@openai-bundled"]
enabled = true

[plugins."code-review@openai-bundled"]
enabled = true

[plugins."whiteboard@devfast"]
enabled = true

[plugins."whiteboard@devfast".mcp_servers.whiteboard.tools.session_get_instructions]
approval_mode = "approve"

[plugins."whiteboard@devfast".mcp_servers.whiteboard.tools.session_capabilities]
approval_mode = "approve"

[plugins."whiteboard@devfast".mcp_servers.whiteboard.tools.session_register_repository]
approval_mode = "approve"

[plugins."whiteboard@devfast".mcp_servers.whiteboard.tools.session_create]
approval_mode = "approve"

[plugins."whiteboard@devfast".mcp_servers.whiteboard.tools.session_activity_begin]
approval_mode = "approve"

[plugins."whiteboard@devfast".mcp_servers.whiteboard.tools.session_diff]
approval_mode = "approve"

[plugins."whiteboard@devfast".mcp_servers.whiteboard.tools.session_lens_edit]
approval_mode = "approve"

[plugins."whiteboard@devfast".mcp_servers.whiteboard.tools.session_activity_end]
approval_mode = "approve"

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
enabled = true

[desktop]
followUpQueueMode = "steer"
enabled-reasoning-efforts = ["low", "medium", "high", "xhigh", "ultra", "persistent", "max"]

[tui]
animations = false
screen_reader_detection_done = true

[features]
memories = true

[memories]
generate_memories = true
use_memories = true

[marketplaces.openai-bundled]
source_type = "local"
source = "{{ .chezmoi.homeDir }}/.codex/.tmp/bundled-marketplaces/openai-bundled"

[marketplaces.claude-tricks]
source_type = "git"
source = "https://github.com/christyjacob4/claude-tricks.git"

[marketplaces.devfast]
source_type = "git"
source = "https://github.com/devdotfast/whiteboard.git"

[marketplaces.openai-primary-runtime]
source_type = "local"
source = "{{ .chezmoi.homeDir }}/.cache/codex-runtimes/codex-primary-runtime/plugins/openai-primary-runtime"

[mcp_servers.graft]
command = "graft"
args = ["mcp"]
